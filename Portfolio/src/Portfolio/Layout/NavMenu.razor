@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@implements IAsyncDisposable
@using Portfolio.Services

<div class="sb-brand-row">
    <a class="sb-brand" href="/#about" @onclick="GoHome" @onclick:preventDefault>
        <img class="sb-avatar" src="assets/profile.webp" alt="Matin Ghanbari" />
        <div>
            <div class="sb-name">Matin Ghanbari</div>
            <div class="sb-role">Software Engineer</div>
        </div>
    </a>
    <button type="button"
            class="sb-mobile-toggle"
            aria-label="@(_drawerOpen ? "Close menu" : "Open menu")"
            aria-expanded="@_drawerOpen.ToString().ToLower()"
            @onclick="ToggleDrawer">
        @(_drawerOpen ? "✕" : "☰")
    </button>
</div>

<div class="sb-mobile-drawer @(_drawerOpen ? "open" : "")">
    <div class="sb-section-label">// Sections</div>
    <nav class="sb-nav">
        @foreach (var item in Sections)
        {
            <a href="/#@item.Id"
                class="@(IsHomeRoute && activeSection == item.Id ? "active" : null)"
                @onclick="() => GoSection(item.Id)" @onclick:preventDefault>
                <span class="idx">@item.Idx</span>
                <span>@item.Label</span>
                <span class="arrow">→</span>
            </a>
        }
    </nav>

    <div class="sb-section-label">// More</div>
    <nav class="sb-nav">
        <NavLink href="/repositories" Match="NavLinkMatch.All" ActiveClass="active"
                    @onclick="CloseDrawer">
            <span class="idx">07</span>
            <span>Public Repositories</span>
            <span class="arrow">→</span>
        </NavLink>
    </nav>

    <div class="sb-foot">
        <div class="sb-socials">
            <a href="tel:+989190845938" target="_blank" rel="noopener" title="Phone"><i class="fa-solid fa-phone"></i></a>
            <a href="mailto:ghanbarimatin6@gmail.com" target="_blank" rel="noopener" title="Gmail"><i class="fa-solid fa-envelope"></i></a>
            <a href="https://linkedin.com/in/matinghanbari" target="_blank" rel="noopener" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
            <a href="https://github.com/matinghanbari" target="_blank" rel="noopener" title="GitHub"><i class="fa-brands fa-github"></i></a>
        </div>
        <div class="sb-meta">
            <span>build @BuildInfo.Stamp</span>
            <span><span class="dot">●</span> v2.0</span>
        </div>
    </div>
</div>


