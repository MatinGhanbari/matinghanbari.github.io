<section class="sec" id="experience">
    <div class="sec-marker">
        <span class="num">02</span>
        <span>Experience</span>
        <span class="rule"></span>
        <span>@Entries.Length entries</span>
    </div>

    <div class="xp-list">
        @foreach (var e in Entries)
        {
            <div class="xp reveal">
                <div class="when">
                    @if (e.When.Contains("Now"))
                    {
                        @(e.When.Replace("Now", ""))
                        <span class="now">Now</span>
                    }
                    else
                    {
                        @e.When
                    }
                </div>
                <div class="role">
                    <h3>@e.Role</h3>
                    <div class="co">
                        @if (!string.IsNullOrEmpty(e.Href))
                        {
                            <a href="@e.Href" target="_blank" rel="noopener">@e.Company ↗</a>
                        }
                        else
                        {
                            @e.Company
                        }
                    </div>
                    <p class="desc">@e.Desc</p>
                    <div class="tags">
                        @foreach (var t in e.Tags)
                        {
                            <span class="tag">@t</span>
                        }
                        @if (e.Shipped is not null)
                        {
                            @foreach (var s in e.Shipped)
                            {
                                <span class="tag shipped">↳ @s</span>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Entry(
        string When,
        string Role,
        string Company,
        string? Href,
        string Desc,
        string[] Tags,
        string[]? Shipped = null);

    private static readonly Entry[] Entries =
    {
        new("Nov 2025 – Present",
            "Senior Software Engineer",
            "PaygahKhodro",
            "https://paygahkhodro.com/",
            "Engineered a high-performance microservices architecture using .NET 9, DDD, and CQRS, optimizing database performance to drive an 8% increase in API responsiveness. Revolutionized CI/CD workflows for 20+ services, slashing deployment times by 45% through Docker optimization and caching strategies, while establishing structured observability and mentoring junior engineers to elevate team delivery standards.",
            new[] { "C#", ".Net", "Blazor", "MSSQL", "Docker", "Microservices", "DDD" },
            new[] { "Automated CI/CD Pipelines", "Observability Dashboard", "Mentored 3 Junior Developers" }),

        new("May 2025 – Nov 2025",
            "Software Engineer",
            "Iran Airtour Airlines",
            "https://iranairtour.ir/",
            "Led the architectural modernization of core framework services, including an end-to-end migration to .NET 8 that substantially improved maintainability and production performance. Established and enforced rigorous code quality protocols and SOLID principles, effectively eliminating long-standing technical debt. Simultaneously optimized high-traffic API and database performance, securing a 27% improvement in response times for a platform serving 10,000+ users.",
            new[] { ".NET 8", "C#", "SQL Server", "API Optimization", "SOLID", "Architecture", "Performance Tuning" },
            new[] { ".NET 5 to .NET 8 Migration", "Framework Refactoring", "API Performance Suite" }),

        new("Jun 2023 – Apr 2025",
