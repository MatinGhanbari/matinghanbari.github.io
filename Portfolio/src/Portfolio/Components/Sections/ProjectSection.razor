@inject IJSRuntime JS

<section class="sec" id="projects">
    <div class="sec-marker">
        <span class="num">03</span>
        <span>Shipped Titles &amp; Projects</span>
        <span class="rule"></span>
    </div>

    <h2 style="margin-bottom: 6px;">Projects</h2>
    <p style="margin: 0 0 18px; color: var(--fg-dim); font-size: 14px;">
        Top selected projects where I’ve contributed.
    </p>

    <div class="strip-controls">
        <span class="count">@ShippedTitles.Length titles · scroll →</span>
        <div class="nav">
            <button type="button" aria-label="Previous" @onclick="() => Scroll(-1)">‹</button>
            <button type="button" aria-label="Next" @onclick="() => Scroll(1)">›</button>
        </div>
    </div>

    <div class="strip-wrap">
        <div class="strip" @ref="stripEl">
            @foreach (var p in ShippedTitles)
            {
                <article class="proj">
                    <div class="cover">
                        <img src="@p.Img" alt="@p.Title" loading="lazy" />
                        <span class="badge">@p.Badge</span>
                    </div>
                    <div class="body">
                        <div class="pmeta">
                            <span class="yr">@p.Year</span>
                            <span>·</span>
                            <span>@p.Role</span>
                        </div>
                        <h4>@p.Title</h4>
                        <p class="desc">@p.Desc</p>
                        <div class="links">
                            @foreach (var l in p.Links)
                            {
                                <a href="@l.Href" target="_blank" rel="noopener">@l.Label ↗</a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>

    <h2 style="margin: 56px 0 6px;">Entertainment Projects</h2>
    <p style="margin: 0 0 4px; color: var(--fg-dim); font-size: 14px;">
        Smaller projects — made with friends for fun.
    </p>

    <div class="itch-grid">
        @foreach (var g in EntertainmentEntries)
        {
            <a class="itch-card reveal" href="@g.Href" target="_blank" rel="noopener">
                <div class="top">
                    <h5>@g.Title</h5>
                    <span class="yr">@g.Year</span>
                </div>
                <p>@g.Desc</p>
                <div class="row">
                    <span>matinghanbari.itch.io</span>
                    <span class="play">play ↗</span>
                </div>
            </a>
        }
    </div>
</section>

@code {
    private ElementReference stripEl;

    private async Task Scroll(int dir) =>
        await JS.InvokeVoidAsync("PortfolioScrollStrip", stripEl, dir);

    private record Shipped(string Title, string Year, string Badge, string Img,
                           string Desc, string Role, ProjectLink[] Links);
    private record ProjectLink(string Label, string Href);
    private record ItchEntry(string Title, string Year, string Desc, string Href);

    private static readonly Shipped[] ShippedTitles =
    {
        new("NexGen.MediatR.Extensions.Caching", "2026", "NugetPackage",
            "/images/projects/nexgen.webp",
            "A lightweight and flexible library that extends MediatR to provide seamless caching and cache invalidation for requests using pipeline behaviors in .NET applications.",
            "C# · Caching · Redis · Garnet · MemoryCache · Mediator",
            new[]
            {
                new ProjectLink("Github", "https://github.com/MatinGhanbari/NexGen.MediatR.Extensions.Caching"),
                new ProjectLink("Nuget",  "https://www.nuget.org/packages/NexGen.MediatR.Extensions.Caching/"),
            }),
    };

    private static readonly ItchEntry[] EntertainmentEntries =
    {
        new("MovieHub", "2024", "Movies for free of all genres!", "https://github.com/MatinGhanbari/moviehub"),
    };
}
