<section class="sec" id="skills">
    <div class="sec-marker">
        <span class="num">05</span>
        <span>Skills</span>
        <span class="rule"></span>
    </div>

    <p style="margin-top: 0; margin-bottom: 28px; max-width: 60ch; color: var(--fg-dim);text-align: justify;">
        Backend Software Engineer with deep expertise in designing scalable distributed systems and robust microservices using the .NET ecosystem, DDD, and CQRS.
        I specialize in crafting high-performance, event-driven architectures, utilizing technologies like PostgreSQL, RabbitMQ, and Redis to ensure system reliability and high availability. 
        My development philosophy is anchored in clean code practices—including SOLID, TDD, and design patterns—complemented by strong DevOps capabilities in Docker and CI/CD pipelines. 
        I thrive in Agile environments, consistently delivering high-quality solutions while contributing to team success through technical mentorship and architectural leadership.
    </p>

    @foreach (var block in Blocks)
    {
        <div class="skill-block">
            <div class="label"><span class="num">@block.Num</span>@block.Label</div>
            <div class="skill-list">
                @foreach (var s in block.Items)
                {
                    <span class="chip">
                        @s.Name
                        <span class="level"><i style="width: @($"{s.Level * 20}%");"></i></span>
                    </span>
                }
            </div>
        </div>
    }
</section>

@code {
    private record Skill(string Name, int Level);
    private record SkillBlock(string Num, string Label, Skill[] Items);

    private static readonly SkillBlock[] Blocks =
    {
        new("01", "Frameworks & Libraries", new[]
        {
            new Skill(".NET / ASP.NET Core", 5),
            new Skill("Blazor", 4),
            new Skill("EF Core", 5),
            new Skill("Dapper", 5),
            new Skill("MediatR", 5),
            new Skill("Hangfire", 5),
        }),
        new("02", "Architecture & System Design", new[]
        {
            new Skill("Microservices", 5),
            new Skill("Distributed Systems", 4),
            new Skill("Event-Driven Architecture", 4),
            new Skill("DDD", 5),
            new Skill("CQRS", 5),
            new Skill("Clean Architecture", 5),
            new Skill("High Availability", 4),
        }),
        new("03", "Databases & Message Brokers", new[]
        {
            new Skill("MS SQL Server", 5),
            new Skill("PostgreSQL", 4),
            new Skill("Redis", 4),
            new Skill("RabbitMQ", 4),
            new Skill("MongoDB", 4),
        }),
        new("04", "DevOps & Infrastructure", new[]
        {
            new Skill("Docker", 5),
            new Skill("CI/CD Pipelines", 5),
            new Skill("Git", 5),
            new Skill("MinIO", 4),
        }),
        new("05", "Engineering Practices", new[]
        {
            new Skill("SOLID", 5),
            new Skill("Design Patterns", 5),
            new Skill("TDD", 5),
            new Skill("Unit/Integration Testing", 5),
            new Skill("Agile/Scrum", 4),
            new Skill("Mentorship", 4),
        }),
    };
}
