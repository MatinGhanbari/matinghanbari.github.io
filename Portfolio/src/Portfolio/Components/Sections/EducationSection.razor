<section class="sec" id="education">
    <div class="sec-marker">
        <span class="num">04</span>
        <span>Education</span>
        <span class="rule"></span>
    </div>

    @foreach (var e in Entries)
    {
        <div class="edu reveal">
            <div class="when">@e.When</div>
            <div>
                <h3>@e.School</h3>
                <div class="deg">@e.Degree</div>
                <p>@e.Desc</p>
            </div>
        </div>
    }
</section>

@code {
    private record EduEntry(string When, string School, string Degree, string? Desc);

    private static readonly EduEntry[] Entries =
    {
        new("2025 – Present",
            "Iran University of Science and Technology",
            "M.S.c. in Software Engineering",
            null),
        new("2020 – 2025",
            "K. N. Toosi University of Technology",
            "B.E. in Computer Engineering",
            "GPA: 17.56 / 20, Rank: Top 15%"),
        new("2014 – 2020",
            "National Organization for Talents (Sampad)",
            "High School Diploma, Mathematics and Physics",
            "GPA: 19.5 / 20"),
    };
}
