@inject IJSRuntime JS

<section class="sec hero" id="about">
    <div class="hero-meta">
        <span><span class="dot">●</span> Tehran, Iran</span>
        <span>·</span>
        <span><a href="mailto:ghanbarimatin6@gmail.com">ghanbarimatin6@gmail.com</a></span>
        <span>·</span>
        <span class="available"><span class="pulse"></span>Open to collaborations · 2026</span>
    </div>

    <h1 class="display reveal">
        Matin Ghanbari<br />
        <span class="last">— Software Engineer.</span>
    </h1>

    <p class="hero-tag reveal">
        I’m a software engineer with about 4 years of experience building reliable, high-performance
        systems using .NET. I really enjoy taking tricky business problems and turning them into
        clean, well-structured solutions using patterns like Domain-Driven Design, CQRS, and
        microservices to keep things both scalable and maintainable. Along the way, I’ve consistently
        focused on making APIs faster, cutting down latency, and writing code that’s easy to read
        and update. I believe good code isn’t just about working today—it’s about staying useful and
        adaptable as a business grows.
    </p>

    <div class="cta-row reveal">
        <a href="/#projects" class="btn btn-primary"
           @onclick='() => ScrollTo("projects")' @onclick:preventDefault>
            View shipped titles <span class="arrow">↓</span>
        </a>
        <a href="mailto:ghanbarimatin6@gmail.com" class="btn">
            Get in touch <span class="arrow">→</span>
        </a>
    </div>

    <div class="hero-stats reveal">
        <div>
            <div class="n">4<span class="unit">+ yrs</span></div>
            <div class="l">Software engineering</div>
        </div>

        <div>
            <div class="n">20<span class="unit">+ projects</span></div>
            <div class="l">professional OpenSource projects</div>
        </div>
    </div>
</section>

@code {
    private async Task ScrollTo(string id)
    {
        await JS.InvokeVoidAsync("BlazorScrollToId", id);
    }
}
